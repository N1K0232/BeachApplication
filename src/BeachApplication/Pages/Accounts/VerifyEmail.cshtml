@page

@model VerifyEmailModel

<div x-data="auth" x-cloak x-init="verifyEmail()">
    <div x-show="!isBusy || errorMessage.trim().length == 0">
        <p x-show="errorMessage.trim().length === 0" x-text="Email successfully verified"></p>
        <p x-show="errorMessage.trim().length > 0" x-text="errorMessage"></p>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("alpine:init", () => {
            auth('@Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName');
        });
    </script>
}