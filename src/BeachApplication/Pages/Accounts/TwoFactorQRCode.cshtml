@page

@model TwoFactorQRCodeModel

<div class="auth" x-data="auth">
    <div x-cloak x-init="getQrCode()">
        <img x-show="!isBusy" :src="qrCodeSrc"/>
        <h4>Scan this code using your authenticator app, then click next to proceed with the validation</h4>
        <button @@click="next()">Next</button>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("alpine:init", () => {
            auth('@Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName');
        });
    </script>
}