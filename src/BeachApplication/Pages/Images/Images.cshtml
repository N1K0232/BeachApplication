@page

@model ImagesModel

<div x-data="images">
    <div class="text-center wrapper">
        <div x-cloak x-init="getImages()">
            <h5 x-show="isBusy">Loading...</h5>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        document.addEventListener("alpine:init", () => {
            images('@Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName');
        });
    </script>
}